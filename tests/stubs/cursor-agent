#!/usr/bin/env node
'use strict'
// Stub `cursor-agent` for `factory review second`. Records
// every call to $FACTORY_STUB_DIR/cursor-agent.log, one JSON argv array per
// line, and answers from $FACTORY_STUB_DIR/cursor-agent.json when present:
//
//   list_models: "ok" (default) | "auth" | "no-model"
//     `--list-models` prints a list holding grok-4.7-high and exits 0, the
//     expired-login line and exits 1, or a list without it and exits 0.
//   sleep_after_assistant: n
//     a review call replays up to and including the n-th `assistant` event,
//     then sleeps 60 s (the caller's timeout kills it).
//   exit_after_assistant: n, exit_code: c (default 1), error_result: text
//     a review call replays up to and including the n-th `assistant` event,
//     writes a `result` event with `is_error` and `text` when error_result is
//     set, then exits c.
//   sleep_secs: n | {"<pass>": n}
//     a review call sleeps n seconds (or its own pass's n), then replays and
//     exits as it would without this key.
//   unlink_stream_on_call: n
//     the review call for pass n deletes its own stream file (under
//     $FACTORY_DATA_DIR/reviews/) and exits 1, so reading it back fails.
//
// Otherwise a review call replays cursor-review.jsonl, a recorded stream,
// to stdout line by line and exits 0. A review call's pass number is the n
// of the `review-n.diff` its prompt names: its replayed result ends with
// `(replayed for pass n)`, and it writes its pid to
// $FACTORY_STUB_DIR/cursor-agent-n.pid (cursor-agent.pid with no pass).
const fs = require('node:fs')
const path = require('node:path')

const argv = process.argv.slice(2)
const stubDir = process.env.FACTORY_STUB_DIR
let scenario = {}
if (stubDir) {
  fs.mkdirSync(stubDir, { recursive: true })
  fs.appendFileSync(path.join(stubDir, 'cursor-agent.log'), `${JSON.stringify(argv)}\n`)
  const p = path.join(stubDir, 'cursor-agent.json')
  if (fs.existsSync(p)) scenario = JSON.parse(fs.readFileSync(p, 'utf8'))
} else {
  console.error('stub cursor-agent: FACTORY_STUB_DIR is not set — the call is not recorded')
}

if (argv.includes('--list-models')) {
  const mode = scenario.list_models ?? 'ok'
  if (mode === 'auth') {
    console.log("Error: Authentication required. Run 'agent login' first, or set CURSOR_API_KEY.")
    process.exit(1)
  }
  const models = ['auto - Auto', 'gpt-5.6-sol-xhigh - GPT 5.6 Sol XHigh', 'gemini-3.7-flash-high - Gemini 3.7 Flash High']
  if (mode !== 'no-model') models.splice(1, 0, 'grok-4.7-high - Grok 4.7 High')
  console.log(`Available models\n\n${models.join('\n')}`)
  process.exit(0)
}

const named = /review-(\d+)\.diff/.exec(argv[argv.length - 1] ?? '')
const pass = named ? Number(named[1]) : undefined
if (stubDir) {
  const pidFile = pass === undefined ? 'cursor-agent.pid' : `cursor-agent-${pass}.pid`
  fs.writeFileSync(path.join(stubDir, pidFile), `${process.pid}\n`)
}

const unlinkOn = scenario.unlink_stream_on_call
if (unlinkOn && pass === unlinkOn) {
  const reviews = path.join(process.env.FACTORY_DATA_DIR, 'reviews')
  for (const d of fs.readdirSync(reviews)) {
    fs.rmSync(path.join(reviews, d, `review-${pass}.jsonl`), { force: true })
  }
  process.exit(1)
}

function replay() {
  const lines = fs.readFileSync(path.join(__dirname, 'cursor-review.jsonl'), 'utf8').split('\n')
  if (lines[lines.length - 1] === '') lines.pop()
  const stop = scenario.sleep_after_assistant
  const quit = scenario.exit_after_assistant
  let seen = 0
  for (let line of lines) {
    const ev = JSON.parse(line)
    if (ev.type === 'result' && pass !== undefined) {
      ev.result = `${ev.result}\n\n(replayed for pass ${pass})`
      line = JSON.stringify(ev)
    }
    fs.writeSync(1, `${line}\n`)
    if (ev.type !== 'assistant') continue
    seen++
    if (stop && seen === stop) {
      setTimeout(() => process.exit(0), 60_000)
      return
    }
    if (quit && seen === quit) {
      if (scenario.error_result !== undefined) {
        const err = { type: 'result', subtype: 'error', is_error: true, result: scenario.error_result }
        fs.writeSync(1, `${JSON.stringify(err)}\n`)
      }
      process.exit(scenario.exit_code ?? 1)
    }
  }
  process.exit(0)
}

const sleepSecs =
  typeof scenario.sleep_secs === 'object' ? scenario.sleep_secs[pass] : scenario.sleep_secs
if (sleepSecs) setTimeout(replay, sleepSecs * 1000)
else replay()
