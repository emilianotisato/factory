#!/usr/bin/env node
'use strict'
// Stub `claude` for the cargo test harness.
//
// Order matters, and it is the order a real worker leaves on disk: record the
// call, pick the scenario step, apply the side effects to the fixture repo
// (state.toml and log.jsonl through `$FACTORY_BIN docs set|log add`, the
// touched code file), then replay a stream cut from a real `claude -p
// --output-format stream-json` recording. The board moves before a single
// event is printed, so a driver that reads `docs status` sees the truth even
// if it never parses the stream. The stub never writes a slice file's status,
// agent-log.md or a log-*.md fragment, and never runs the node docs tool; the
// binary allocates every id.
//
// Scenario steps come from $FACTORY_STUB_DIR/plan.jsonl, one JSON object per
// spawn, read by spawn number (call n takes line n); past the end every spawn
// is `{"outcome":"done"}`. The role is the pack's first section: `# Gate
// failure` or `# CI failure` is a fix worker, `# Gate transcript` a checkpoint
// worker, `# Branch` the polish, `# Conflict` a merge worker (the driver redid
// a conflicted pick in the slice's lane), anything else a slice worker.
//
// Step keys:
//   outcome: `done` (default); `dead` (init, then exit 137 with no result);
//     `blocked` (a `block` entry in the log, `status: blocked` on a slice,
//     exit 0; a later spawn whose pack carries `# Block and answer` builds to
//     `done`); `fix`, `checkpoint` and `polish` are `done` for that role;
//     `rate_limited` / `rate_limited_no_reset` on every role (init, one
//     `rate_limit_event` with `status: rejected`, an error result naming the
//     limit, exit 1, nothing on the board moves).
//   touch: [...] the code files written. Default: a slice's own
//     src/slice-NN.txt, so two lanes landing from one base never meet in one
//     file; fix and polish keep src/lib.txt; a merge writes none, so with no
//     `sh` either the conflict markers stay.
//   question: the block's title. delay_ms: a sleep before anything is printed.
//   reset_s: how far ahead `resetsAt` is (default 120).
//   stray: [...] files written with no tool call naming them (slice, fix,
//     polish). sh: "<script>", run as `sh -c` in cwd after the touched files,
//     the stream carrying one Bash call and no tool call naming what it
//     changed; a nonzero exit fails the stub with exit 65 (slice, fix, polish,
//     merge).
//   inner: "red" makes the one `Bash ./gate.sh --inner` call (every `done`
//     slice, fix, polish and merge) return the gate's failure text, exit 1.
//   On a `done` slice: heredoc: [...] files written by a `Bash cat > f <<'EOF'`
//     call the stream carries; commit: [...] files the worker commits itself
//     before anything else; git_add: "<args>", a real `git add` the stream
//     carries as a Bash call; ctx: true, two `Bash factory ctx …` calls with
//     canned answers (not run), a `refs` naming src/lib.txt followed by a Read
//     of it and an `outline` naming src/other.rs that nothing reads;
//     wait_sh: "<script>", a barrier polled until it exits 0; linger_ms, a
//     sleep after `done` is on the board and before the stream; board: false
//     sets neither `building` nor `done` and carries no `docs set` call, so
//     the slice is `done` only if the driver writes it.
//   On a polish: slices: {"02": "building"} forces slice statuses first;
//     skip: ["retro", "body", "findings"] leaves those out; friction: text is
//     the retro's `## Framework friction → factory` section; subagents: n
//     replays polish-subagents.jsonl and writes `subagents/agent-<i>.jsonl`
//     under the session's transcript dir in $CLAUDE_CONFIG_DIR, and
//     subagents_unreadable: true then makes that dir mode 000.
//   On a checkpoint: leaks: "fix" deletes every `path:line` hit under the
//     pack's `# Leaks` (bottom-up per file) and every bare `path` hit, then
//     names each one under **Fixed** and FIXED: instead of `none`.
//
// The call record ($FACTORY_STUB_DIR/calls/<n>.json) carries argv, cwd, HEAD,
// the FACTORY_* env, every env variable's name (never a value), GH_CONFIG_DIR,
// the GIT_CONFIG_* variables with values, prompt, pack, session id, model,
// effort and settings. `claude --version` alone prints a fixed string and
// records no call; every assistant line's `message.model` is `init.model`.
//
// A `claude plugin …` call is recorded, then answered from
// $FACTORY_STUB_DIR/plugins.json and never starts a worker stream: the two
// `list --json` calls print what `marketplace add` (the name in the folder's
// .claude-plugin/marketplace.json) and `install` marked present.
const fs = require('node:fs')
const path = require('node:path')
const crypto = require('node:crypto')

const argv = process.argv.slice(2)
if (argv.length === 1 && argv[0] === '--version') {
  process.stdout.write('2.1.296 (Claude Code)\n')
  process.exit(0)
}
const cwd = process.cwd()
const stubDir = process.env.FACTORY_STUB_DIR
if (!stubDir) fail(64, 'FACTORY_STUB_DIR is not set — the harness sets it (tests/harness/mod.rs)')

// ── 1. record the call ───────────────────────────────────────────────────────
const flags = parseFlags(argv)
let pack = null
let packSource = null
if (flags['--append-system-prompt-file'] !== undefined) {
  const file = flags['--append-system-prompt-file']
  if (!fs.existsSync(file)) fail(66, `--append-system-prompt-file ${file} does not exist`)
  pack = fs.readFileSync(file, 'utf8')
  packSource = 'file'
} else if (flags['--append-system-prompt'] !== undefined) {
  pack = flags['--append-system-prompt']
  packSource = 'inline'
}
const callsDir = path.join(stubDir, 'calls')
fs.mkdirSync(callsDir, { recursive: true })
// The pack's spawn number orders racing lanes; claimed empty, filled by rename, so a poll never reads half a call.
const packName = path.basename(String(flags['--append-system-prompt-file'] ?? ''))
const spawnNo = packName.match(/^(?:slice-\d{2}|merge-\d{2}|fix-\d+|checkpoint-\d+|polish|ci-fix-\d+)-(\d+)\.md$/)
let n = spawnNo ? Number(spawnNo[1]) : 1
let fd
for (;;) {
  try {
    fd = fs.openSync(path.join(callsDir, `${n}.json`), 'wx')
    break
  } catch (e) {
    if (e.code !== 'EEXIST') throw e
    n++
  }
}
const factoryEnv = Object.fromEntries(Object.entries(process.env).filter(([k]) => k.startsWith('FACTORY_')))
const sessionId = flags['--session-id'] ?? crypto.randomUUID()
fs.closeSync(fd)
const headRev = require('node:child_process').spawnSync('git', ['rev-parse', 'HEAD'], { cwd, encoding: 'utf8' })
const head = headRev.status === 0 ? headRev.stdout.trim() : null
writeAtomic(path.join(callsDir, `${n}.json`), JSON.stringify({
  n,
  argv,
  cwd,
  head,
  env: factoryEnv,
  env_keys: Object.keys(process.env).sort(),
  gh_config_dir: process.env.GH_CONFIG_DIR ?? null,
  git_config: Object.fromEntries(Object.entries(process.env).filter(([k]) => /^GIT_CONFIG_(COUNT|KEY_\d+|VALUE_\d+)$/.test(k))),
  prompt: flags['-p'] ?? null,
  pack,
  pack_source: packSource,
  session_id: sessionId,
  model: flags['--model'] ?? null,
  effort: flags['--effort'] ?? null,
  settings: flags['--settings'] ?? null,
}, null, 2))
if (argv[0] === 'plugin') plugin(argv.slice(1))

// ── 2. pick the step ─────────────────────────────────────────────────────────
let step = { outcome: 'done' }
const planPath = path.join(stubDir, 'plan.jsonl')
if (fs.existsSync(planPath)) {
  const lines = fs.readFileSync(planPath, 'utf8').split('\n').filter((l) => l.trim())
  if (lines[n - 1]) step = JSON.parse(lines[n - 1])
}
if (pack === null) fail(65, 'no pack: pass --append-system-prompt-file <path> or --append-system-prompt <text>')
// A merge pack also names the slice file, so `# Conflict` is matched before the slice fallback.
const role = pack.match(/^# .*$/m)?.[0] === '# Conflict'
  ? 'merge'
  : /^# (?:Gate failure|CI failure)$/m.test(pack)
  ? 'fix'
  : /^# Gate transcript$/m.test(pack)
    ? 'checkpoint'
    : /^# Branch$/m.test(pack)
      ? 'polish'
      : 'slice'
const limited = ['rate_limited', 'rate_limited_no_reset']
const allowed = {
  slice: ['done', 'dead', 'blocked', ...limited],
  fix: ['fix', 'done', 'dead', ...limited],
  checkpoint: ['checkpoint', 'done', 'dead', 'blocked', ...limited],
  polish: ['polish', 'done', 'dead', 'blocked', ...limited],
  merge: ['done', 'dead', 'blocked', ...limited],
}
if (!['done', 'dead', 'blocked', 'fix', 'checkpoint', 'polish', ...limited].includes(step.outcome)) fail(65, `outcome "${step.outcome}" is not one the stub knows`)
if (!allowed[role].includes(step.outcome)) fail(65, `outcome "${step.outcome}" on step ${n} does not fit a ${role} worker — the plan's order and the driver's spawn order disagree`)

const tpl = JSON.parse(fs.readFileSync(path.join(__dirname, 'stream.json'), 'utf8'))
let seq = 0
const init = { ...tpl.init, cwd, session_id: sessionId, uuid: crypto.randomUUID() }
if (flags['--model']) init.model = flags['--model']
// `res` overrides the tool_result: `{ text, error }`.
const tool = (name, input, res) => {
  const id = `toolu_stub_${n}_${++seq}`
  emit(assistant([{ type: 'tool_use', id, name, input }]))
  const text = res?.text ?? (name === 'Edit' ? `The file ${input.file_path} has been updated.` : `File written: ${input.file_path}`)
  emit(user(id, text, res?.error ?? false))
}
// The worker's own inner-loop run, as one `Bash` call; not executed, so scenario/inner and gate.log stay the test's.
const innerRun = (step) =>
  tool(
    'Bash',
    { command: './gate.sh --inner', description: 'inner loop' },
    step.inner === 'red' ? { text: 'FAIL tests/fake.rs: expected 2 got 3\n\nExit code 1', error: true } : { text: 'ok' },
  )
const readFile = (file) => tool('Read', { file_path: file }, { text: fs.readFileSync(file, 'utf8') })
const result = (lines) => emit({ ...tpl.result, session_id: sessionId, uuid: crypto.randomUUID(), result: lines.join('\n') })

// ── a worker that hit a usage limit ──────────────────────────────────────────
// The driver may run on a scaled clock (src/clock.rs: FACTORY_CLOCK_SCALE with
// FACTORY_CLOCK_ANCHOR); `resetsAt` has to be on that same clock.
const now = () => {
  const wall = Math.floor(Date.now() / 1000)
  const scale = Number(process.env.FACTORY_CLOCK_SCALE ?? 1)
  if (!(scale > 1)) return wall
  const anchor = Number(process.env.FACTORY_CLOCK_ANCHOR ?? wall)
  return anchor + (wall - anchor) * scale
}
const rateLimited = (step) => {
  if (step.delay_ms) sleep(Number(step.delay_ms))
  emit(init)
  const info = { ...tpl.rate_limit_event.rate_limit_info, status: 'rejected' }
  if (step.outcome === 'rate_limited_no_reset') delete info.resetsAt
  else info.resetsAt = now() + Number(step.reset_s ?? 120)
  emit({ ...tpl.rate_limit_event, rate_limit_info: info, session_id: sessionId, uuid: crypto.randomUUID() })
  emit({
    ...tpl.result,
    session_id: sessionId,
    uuid: crypto.randomUUID(),
    subtype: 'error_during_execution',
    is_error: true,
    num_turns: 1,
    result: "You've hit your usage limit. Your limit will reset at the time above.",
  })
  process.exit(1)
}

// ── 3a. a fix worker ─────────────────────────────────────────────────────────
if (role === 'fix') {
  if (limited.includes(step.outcome)) rateLimited(step)
  if (step.delay_ms) sleep(Number(step.delay_ms))
  if (step.outcome === 'dead') {
    emit(init)
    process.exit(137)
  }
  const touched = (step.touch ?? ['src/lib.txt']).map((f) => path.resolve(cwd, f))
  for (const f of touched) {
    fs.mkdirSync(path.dirname(f), { recursive: true })
    fs.appendFileSync(f, `fixed by spawn ${n}\n`)
  }
  writeStray(step)
  const sh = runSh(step)
  const rel = touched.map((f) => path.relative(cwd, f)).join(', ')
  emit(init)
  for (const f of touched) tool('Write', { file_path: f, content: `fixed by spawn ${n}\n` })
  shCall(step, sh)
  innerRun(step)
  emit(assistant([{ type: 'text', text: 'STATUS: done' }]))
  result([
    'STATUS: done',
    `INNER: 1 runs, ${step.inner === 'red' ? 1 : 0} red, 0 min — caught: nothing`,
    `FIXED: ${rel} — stub fix (spawn ${n})`,
    'DECISIONS: none',
    'BLOCK: none',
  ])
  process.exit(0)
}

// ── 3b. a checkpoint worker ──────────────────────────────────────────────────
if (role === 'checkpoint') {
  const cp = Number((flags['-p'] ?? '').match(/checkpoint (\d+)/)?.[1] ?? 1)
  const covered = [...pack.matchAll(/^## slice-(\d{2})/gm)].map((x) => x[1])
  const rows = [...new Set([...pack.matchAll(/^\| (FR-\d+) \|/gm)].map((x) => x[1]))]
  const dirM = pack.match(/<!-- (docs\/features\/[^/\s]+)\//)
  if (!dirM) fail(65, 'the checkpoint pack names no docs/features/<dir>/ file')
  const cpFeature = featureOf(dirM[1])
  if (limited.includes(step.outcome)) rateLimited(step)
  if (step.delay_ms) sleep(Number(step.delay_ms))
  if (step.outcome === 'dead') {
    emit(init)
    process.exit(137)
  }
  const today = new Date().toISOString().slice(0, 10)
  if (step.outcome === 'blocked') {
    const question = step.question ?? 'Which row does the owner want proven by hand?'
    const add = ['log', 'add', cpFeature, '--kind', 'block', '--phase', 'checkpoint', '--title', question, '--body-file', '-']
    const block = docs(add, [
      `**Happened:** the stub checkpoint worker at checkpoint ${cp} reached a fork the contract does not settle.`,
      '**Options:** 1. the Recommended option; 2. the other one.',
      '**Recommended:** 1 — it is the one the fixture expects.',
    ].join('\n'))
    emit(init)
    docsCall(add, block)
    emit(assistant([{ type: 'text', text: `STATUS: blocked\nBLOCK: ${block}` }]))
    result(['STATUS: blocked', 'PROVE: 0/0 — evidence: none — unreached: all', 'FIXED: none', `BLOCK: ${block} — ${question}`])
    process.exit(0)
  }
  const fixed = step.leaks === 'fix' ? fixLeaks(pack, cwd) : []
  const fixedText = fixed.length ? fixed.map((h) => `leaks: ${h}`).join(', ') : 'none'
  const last = covered[covered.length - 1] ?? '00'
  let evidence = 'none (stub)'
  if (process.env.FACTORY_EVIDENCE) {
    const cpDir = path.join(process.env.FACTORY_EVIDENCE, `cp-${cp}`)
    fs.mkdirSync(cpDir, { recursive: true })
    fs.writeFileSync(path.join(cpDir, 'row.txt'), `${rows.join(', ') || 'none'}: proven by the stub at checkpoint ${cp}\n`)
    evidence = `cp-${cp}/row.txt`
  }
  const add = ['log', 'add', cpFeature, '--kind', 'checkpoint', '--phase', 'checkpoint', '--slice', String(Number(last)), '--covers', covered.map(Number).join(','), '--title', `after slice-${last} · ${today}`, '--body-file', '-']
  const id = docs(add, [
    `**Covers:** slices ${covered.join(', ')}`,
    '**Gate:** 1 runs, 0 red, 0 min — caught: nothing (driver-run)',
    `**Prove:** ${rows.join(', ') || 'none'} — evidence: ${evidence}`,
    `**Fixed:** ${fixedText}`,
  ].join('\n'))
  emit(init)
  docsCall(add, id)
  emit(assistant([{ type: 'text', text: 'STATUS: done' }]))
  result(['STATUS: done', `PROVE: ${rows.length}/${rows.length} — evidence: ${evidence} — unreached: none`, `FIXED: ${fixedText}`, 'BLOCK: none'])
  process.exit(0)
}

// The hits as `path:line` or `path`, once each, in the report's order.
function fixLeaks (pack, cwd) {
  const section = pack.match(/^# Leaks$([\s\S]*?)(?=^# |(?![\s\S]))/m)?.[1] ?? ''
  const hits = []
  const lines = new Map()
  const paths = []
  for (const l of section.split('\n')) {
    const at = l.match(/^ {2}(\S+):(\d+) {2}/)
    const bare = at ? null : l.match(/^ {2}(\S+)$/)
    if (at) {
      const hit = `${at[1]}:${at[2]}`
      if (hits.includes(hit)) continue
      hits.push(hit)
      if (!lines.has(at[1])) lines.set(at[1], [])
      lines.get(at[1]).push(Number(at[2]))
    } else if (bare && !hits.includes(bare[1])) {
      hits.push(bare[1])
      paths.push(bare[1])
    }
  }
  for (const [rel, nums] of lines) {
    const abs = path.resolve(cwd, rel)
    if (!fs.existsSync(abs)) continue
    const text = fs.readFileSync(abs, 'utf8').split('\n')
    for (const k of [...nums].sort((a, b) => b - a)) text.splice(k - 1, 1)
    fs.writeFileSync(abs, text.join('\n'))
  }
  for (const rel of paths) fs.rmSync(path.resolve(cwd, rel), { force: true })
  return hits
}

// ── 3c. a polish worker ──────────────────────────────────────────────────────
if (role === 'polish') {
  const runDir = pack.match(/^<!-- run dir: (.+?) -->$/m)?.[1]
  const dirM = pack.match(/<!-- (docs\/features\/[^/\s]+)\//)
  if (!runDir || !dirM) fail(65, 'the polish pack names no run dir or no docs/features/<dir>/ file')
  const featDir = path.resolve(cwd, dirM[1])
  const feature = featureOf(dirM[1])
  const prd = path.join(featDir, 'prd.md')
  const retro = path.join(featDir, 'retro.md')
  if (limited.includes(step.outcome)) rateLimited(step)
  if (step.delay_ms) sleep(Number(step.delay_ms))
  if (step.outcome === 'dead') {
    emit(init)
    process.exit(137)
  }
  const today = new Date().toISOString().slice(0, 10)
  if (step.outcome === 'blocked') {
    const question = step.question ?? 'Which review finding does the owner want kept?'
    const add = ['log', 'add', feature, '--kind', 'block', '--phase', 'polish', '--title', question, '--body-file', '-']
    const block = docs(add, [
      '**Happened:** the stub polish worker reached a fork the review does not settle.',
      '**Options:** 1. the Recommended option; 2. the other one.',
      '**Recommended:** 1 — it is the one the fixture expects.',
    ].join('\n'))
    emit(init)
    docsCall(add, block)
    emit(assistant([{ type: 'text', text: `STATUS: blocked\nBLOCK: ${block}` }]))
    result(['STATUS: blocked', 'FIXED: nothing', 'RETRO: not written: blocked', 'PR_BODY: not written: blocked', 'DECISIONS: none', `BLOCK: ${block} — ${question}`])
    process.exit(0)
  }
  for (const [nn, status] of Object.entries(step.slices ?? {})) {
    const f = fs.readdirSync(featDir).find((f) => f.startsWith(`slice-${nn}-`) && f.endsWith('.md'))
    if (!f) fail(65, `step.slices names slice ${nn}, which ${dirM[1]} does not have`)
    setStatus(feature, nn, status)
  }
  const touched = (step.touch ?? ['src/lib.txt']).map((f) => path.resolve(cwd, f))
  for (const f of touched) {
    fs.mkdirSync(path.dirname(f), { recursive: true })
    fs.appendFileSync(f, `polished by spawn ${n}\n`)
  }
  writeStray(step)
  const sh = runSh(step)
  const rel = touched.map((f) => path.relative(cwd, f)).join(', ')
  const skip = new Set(step.skip ?? [])
  // The template as the pack carries it: no frontmatter, the driver writes the numbers.
  const tplM = pack.match(/^# Retro\n[\s\S]*?\n````markdown\n([\s\S]*?)\n````/m)
  if (!tplM) fail(65, 'the polish pack has no ````markdown retro template under # Retro')
  if (!tplM[1].startsWith('# Retro — PRD-')) fail(65, 'the retro template in the pack does not open with its # Retro heading')
  const friction = typeof step.friction === 'string' ? `## Framework friction → factory\n\n${step.friction}\n\n` : ''
  const retroText = `# Retro — PRD-${dirM[1].match(/(\d{3})-/)[1]}\n\n## Cost vs catch\n\nStub retro (spawn ${n}).\n\n${friction}## Score\n\nThe owner's.\n`
  if (!skip.has('retro')) writeAtomic(retro, retroText)
  const reviewed = ['set', feature, `reviewed=${today}`]
  docs(reviewed)
  const body = path.join(runDir, 'pr-body.md')
  fs.mkdirSync(runDir, { recursive: true })
  if (!skip.has('body')) writeAtomic(body, `## PRD-${dirM[1].match(/(\d{3})-/)[1]} — Fixture\n\nStub PR body (spawn ${n}). PR: \`${dirM[1]}/prd.md\`\n\n### Needs your review\n\n- none\n\n### Human QA\n\nNone — every QA-plan row was proven by the run.\n`)
  emit(init)
  if (step.subagents) subagentRun(step)
  readFile(prd)
  for (const f of touched) tool('Write', { file_path: f, content: `polished by spawn ${n}\n` })
  shCall(step, sh)
  innerRun(step)
  if (!skip.has('retro')) tool('Write', { file_path: retro, content: retroText })
  docsCall(reviewed, '')
  if (!skip.has('body')) tool('Write', { file_path: body, content: fs.readFileSync(body, 'utf8') })
  emit(assistant([{ type: 'text', text: 'STATUS: done' }]))
  result([
    'STATUS: done',
    `FIXED: ${rel} — stub polish (spawn ${n})`,
    ...(skip.has('findings') ? [] : ['FINDINGS high=1 medium=2 low=3 fixed=4 parked=2']),
    skip.has('retro') ? 'RETRO: not written: skipped' : 'RETRO: written',
    skip.has('body') ? 'PR_BODY: not written: skipped' : 'PR_BODY: written',
    'DECISIONS: none',
    'BLOCK: none',
  ])
  process.exit(0)
}

// ── 3d. a merge worker ───────────────────────────────────────────────────────
// The slice's status is the driver's: no outcome here writes it.
if (role === 'merge') {
  const { nn, slicePath, feature } = findSlice()
  if (limited.includes(step.outcome)) rateLimited(step)
  if (step.delay_ms) sleep(Number(step.delay_ms))
  if (step.outcome === 'dead') {
    emit(init)
    process.exit(137)
  }
  if (step.outcome === 'blocked') {
    const question = step.question ?? 'Which side of the conflict does the owner want?'
    const add = ['log', 'add', feature, '--kind', 'block', '--slice', String(Number(nn)), '--title', question, '--body-file', '-']
    const block = docs(add, [
      `**Happened:** the stub merge worker on slice ${nn} could not resolve the conflict.`,
      '**Options:** 1. the Recommended option; 2. the other one.',
      '**Recommended:** 1 — it is the one the fixture expects.',
    ].join('\n'))
    emit(init)
    docsCall(add, block)
    emit(assistant([{ type: 'text', text: `STATUS: blocked\nBLOCK: ${block}` }]))
    result(['STATUS: blocked', 'INNER: 0 runs, 0 red, 0 min — caught: nothing', 'DECISIONS: none', `BLOCK: ${block} — ${question}`])
    process.exit(0)
  }
  const touched = (step.touch ?? []).map((f) => path.resolve(cwd, f))
  for (const f of touched) {
    fs.mkdirSync(path.dirname(f), { recursive: true })
    fs.appendFileSync(f, `merged by spawn ${n}\n`)
  }
  const sh = runSh(step)
  emit(init)
  readFile(slicePath)
  for (const f of touched) tool('Write', { file_path: f, content: `merged by spawn ${n}\n` })
  shCall(step, sh)
  innerRun(step)
  emit(assistant([{ type: 'text', text: 'STATUS: done' }]))
  result([
    'STATUS: done',
    `INNER: 1 runs, ${step.inner === 'red' ? 1 : 0} red, 0 min — caught: nothing`,
    'DECISIONS: none',
    'BLOCK: none',
  ])
  process.exit(0)
}

// ── 3. find the slice ────────────────────────────────────────────────────────
const { nn, slicePath, featureDir, feature } = findSlice()

// ── 4. side effects ──────────────────────────────────────────────────────────
if (limited.includes(step.outcome)) rateLimited(step)
const ownsBoard = !(step.board === false && (step.outcome ?? 'done') === 'done')
if (ownsBoard) setStatus(feature, nn, 'building')
if (step.delay_ms) sleep(Number(step.delay_ms))
if (step.wait_sh) waitFor(step.wait_sh)
if (step.outcome === 'dead') {
  emit(init)
  process.exit(137)
}
// The driver's `# Block and answer` section is the mark of an answered
// respawn — not `**Resolution (`, which the agent-log template quotes.
const answered = /^# Block and answer$/m.test(pack)
if (step.outcome === 'blocked' && !answered) {
  const question = step.question ?? 'Which option does the owner want?'
  const add = ['log', 'add', feature, '--kind', 'block', '--slice', String(Number(nn)), '--title', question, '--body-file', '-']
  const block = docs(add, [
    `**Happened:** the stub worker on slice ${nn} reached a fork the slice does not settle.`,
    '**Options:** 1. the Recommended option; 2. the other one.',
    '**Recommended:** 1 — it is the one the fixture expects.',
  ].join('\n'))
  setStatus(feature, nn, 'blocked')
  emit(init)
  docsCall(add, block)
  docsCall(['set', feature, `slices.${Number(nn)}.status=blocked`], '')
  emit(assistant([{ type: 'text', text: `STATUS: blocked\nBLOCK: ${block}` }]))
  const text = [
    'STATUS: blocked',
    'COMMIT: none',
    `LANE: ${process.env.FACTORY_LANE ?? 1}`,
    'INNER: 0 runs, 0 red, 0 min — caught: nothing',
    'PROVE: none: stub worker',
    'DECISIONS: none',
    `BLOCK: ${block} — ${question}`,
  ].join('\n')
  emit({ ...tpl.result, session_id: sessionId, uuid: crypto.randomUUID(), result: text })
  process.exit(0)
}
const touched = (step.touch ?? [`src/slice-${nn}.txt`]).map((f) => path.resolve(cwd, f))
for (const f of touched) {
  fs.mkdirSync(path.dirname(f), { recursive: true })
  fs.appendFileSync(f, `touched by spawn ${n}\n`)
}
for (const f of step.commit ?? []) {
  const git = (...args) => require('node:child_process').execFileSync('git', args, { cwd })
  git('add', '--', f)
  git('commit', '-q', '-m', `chore: commit ${f}`, '--', f)
}
writeStray(step)
for (const f of step.heredoc ?? []) {
  const abs = path.resolve(cwd, f)
  fs.mkdirSync(path.dirname(abs), { recursive: true })
  fs.writeFileSync(abs, `heredoc from spawn ${n}\n`)
}
if (step.git_add) {
  require('node:child_process').execFileSync('git', ['add', ...step.git_add.split(' ')], { cwd })
}
const sh = runSh(step)
function writeStray(step) {
  for (const f of (step.stray ?? []).map((f) => path.resolve(cwd, f))) {
    fs.mkdirSync(path.dirname(f), { recursive: true })
    fs.appendFileSync(f, `stray from spawn ${n}\n`)
  }
}
const touchedRel = touched.map((f) => path.relative(cwd, f)).join(', ')
const adAdd = ['log', 'add', feature, '--kind', 'decision', '--slice', String(Number(nn)), '--title', 'Which code file does the stub worker touch?', '--body-file', '-']
const ad = docs(adAdd, [
  `**Chose:** append one line to ${touchedRel} (spawn ${n})`,
  '**Over:** a shared code file, which two lanes landing from one base would conflict on',
  '**Because:** the scenario step chooses the touched set; by default each slice owns its src/slice-NN.txt',
  '**Undo:** drop the appended line',
  '**Review:** no',
].join('\n'))
progress(slicePath, n, touchedRel, ad)
if (ownsBoard) setStatus(feature, nn, 'done')
if (step.linger_ms) sleep(Number(step.linger_ms))

// ── 5. the stream ────────────────────────────────────────────────────────────
emit(init)
readFile(path.join(featureDir, 'prd.md'))
readFile(slicePath)
if (step.ctx) {
  tool('Bash', { command: 'factory ctx refs fixture', description: 'ctx refs' }, { text: 'src/lib.txt:1  ref  fixture code file\n\n1 hit in 1 file (searched 1 file)\n' })
  readFile(path.join(cwd, 'src/lib.txt'))
  tool('Bash', { command: 'factory ctx outline src', description: 'ctx outline' }, { text: '== src/other.rs ==\n1  fn  fn other() {\n' })
}
for (const f of touched) tool('Write', { file_path: f, content: `touched by spawn ${n}\n` })
for (const f of step.heredoc ?? []) {
  tool('Bash', { command: `mkdir -p ${path.dirname(f)} && cat > ${f} <<'EOF'\nheredoc from spawn ${n}\nEOF`, description: 'write' })
}
if (step.git_add) tool('Bash', { command: `git add ${step.git_add}`, description: 'claim' })
shCall(step, sh)
docsCall(adAdd, ad)
innerRun(step)
if (ownsBoard) docsCall(['set', feature, `slices.${Number(nn)}.status=done`], '')
emit(assistant([{ type: 'text', text: 'STATUS: done' }]))
const resultText = [
  'STATUS: done',
  'COMMIT: none',
  `LANE: ${process.env.FACTORY_LANE ?? 1}`,
  `INNER: 1 runs, ${step.inner === 'red' ? 1 : 0} red, 0 min — caught: nothing`,
  'PROVE: none: stub worker',
  `DECISIONS: ${ad}`,
  'BLOCK: none',
].join('\n')
emit({ ...tpl.result, session_id: sessionId, uuid: crypto.randomUUID(), result: resultText })
process.exit(0)

// ── helpers ──────────────────────────────────────────────────────────────────
// The slice file the pack names, resolved from cwd or found by its name under
// docs/features/.
function findSlice() {
  const m = pack.match(/((?:\/|\.\/)?[\w./-]*slice-(\d{2})-[\w-]+\.md)/)
  if (!m) fail(65, 'the pack names no slice-NN-*.md file')
  let slicePath = path.isAbsolute(m[1]) ? m[1] : path.resolve(cwd, m[1])
  if (!fs.existsSync(slicePath)) {
    const base = path.basename(m[1])
    const features = path.join(cwd, 'docs', 'features')
    const hit = fs.existsSync(features)
      ? fs.readdirSync(features).map((d) => path.join(features, d, base)).find((p) => fs.existsSync(p))
      : null
    if (!hit) fail(65, `slice file ${m[1]} not found under ${cwd}`)
    slicePath = hit
  }
  const featureDir = path.dirname(slicePath)
  return { nn: m[2], slicePath, featureDir, feature: featureOf(path.basename(featureDir)) }
}

function runSh(step) {
  if (typeof step.sh !== 'string') return null
  const r = require('node:child_process').spawnSync('sh', ['-c', step.sh], { cwd, encoding: 'utf8' })
  if (r.status !== 0) fail(65, `step ${n}'s sh exited ${r.status ?? r.signal}: ${r.stderr || r.error?.message || ''}`)
  return `${r.stdout}${r.stderr}` || 'ok'
}

function shCall(step, out) {
  if (out !== null) tool('Bash', { command: step.sh, description: 'edit' }, { text: out })
}

function parseFlags(args) {
  const out = {}
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (!a.startsWith('-')) continue
    const eq = a.indexOf('=')
    if (eq !== -1) { out[a.slice(0, eq)] = a.slice(eq + 1); continue }
    const next = args[i + 1]
    if (next !== undefined && !next.startsWith('-')) { out[a] = next; i++ } else out[a] = true
  }
  return out
}

// Rename, not a truncating write: a poller never sees a half file, and the temp stays out of git status.
function writeAtomic(file, text) {
  const tmp = path.join(stubDir, `.write-${process.pid}.tmp`)
  fs.writeFileSync(tmp, text)
  try {
    fs.renameSync(tmp, file)
  } catch (e) {
    fs.rmSync(tmp, { force: true })
    throw e
  }
}

// The feature number of a `docs/features/NNN-slug` path or folder name.
function featureOf(dir) {
  const m = path.basename(dir).match(/^(\d{3})-/)
  if (!m) fail(65, `${dir} is not a NNN-slug feature folder`)
  return m[1]
}

// The board moves through the binary under test, the way a real worker's does.
function docs(args, input = '') {
  const bin = process.env.FACTORY_BIN
  if (!bin) fail(64, 'FACTORY_BIN is not set — the harness sets it (tests/harness/mod.rs)')
  try {
    return require('node:child_process').execFileSync(bin, ['docs', ...args], { cwd, input, encoding: 'utf8' }).trim()
  } catch (e) {
    fail(65, `factory docs ${args.join(' ')}: ${e.stderr || e.message}`)
  }
}

function docsCall(args, out) {
  const quoted = args.map((a) => (/^[\w./=,:-]+$/.test(a) ? a : `'${a.replace(/'/g, "'\\''")}'`)).join(' ')
  tool('Bash', { command: `factory docs ${quoted}`, description: 'docs' }, { text: out || 'ok' })
}

function setStatus(feature, nn, status) {
  docs(['set', feature, `slices.${Number(nn)}.status=${status}`])
}

function progress(file, spawn, rel, ad) {
  const text = fs.readFileSync(file, 'utf8')
  const line = `**Progress**: built by the stub claude (spawn ${spawn}) — appended to ${rel}; ${ad} in log.jsonl.`
  const re = /^\*\*Progress\*\*:.*$/m
  const out = re.test(text)
    ? text.replace(re, (cur) => (/_\(written as it lands/.test(cur) ? line : `${cur} · stub spawn ${spawn}`))
    : `${text.trimEnd()}\n\n${line}\n`
  writeAtomic(file, out)
}

// Each message is logged twice with a growing output, as Claude Code streams one: the last usage per id counts.
// A function: the polish branch calls subagentRun before a const this far down would be initialised.
function subagentFixtures() {
  return [
    [
      { id: 'msg_sub_a1', input: 3, cw: 1000, cr: 20000, out: [10, 400] },
      { id: 'msg_sub_a2', input: 5, cw: 2000, cr: 21000, out: [50, 300] },
    ],
    [
      { id: 'msg_sub_b1', input: 7, cw: 500, cr: 30000, out: [20, 200] },
      { id: 'msg_sub_b2', input: 1, cw: 100, cr: 31000, out: [5, 100] },
    ],
  ]
}

// The cut stream, then the transcript dir the driver reads after exit.
function subagentRun(step) {
  const fixtures = subagentFixtures()
  const count = Number(step.subagents)
  if (!(count >= 1 && count <= fixtures.length)) fail(65, `subagents: ${step.subagents} — the stub has ${fixtures.length} fixtures`)
  const cut = fs.readFileSync(path.join(__dirname, 'polish-subagents.jsonl'), 'utf8').split('\n').filter((l) => l.trim())
  for (const line of cut) {
    emit({ ...JSON.parse(line), session_id: sessionId, uuid: crypto.randomUUID(), timestamp: new Date().toISOString() })
  }
  const configDir = process.env.CLAUDE_CONFIG_DIR
  if (!configDir) fail(64, 'CLAUDE_CONFIG_DIR is not set — the harness sets it (tests/harness/mod.rs)')
  // The driver's rule (src/measure.rs transcript_path): every character of the cwd but a letter or digit as "-".
  const slug = cwd.replace(/[^A-Za-z0-9]/g, '-')
  const dir = path.join(configDir, 'projects', slug, sessionId, 'subagents')
  fs.mkdirSync(dir, { recursive: true })
  for (let i = 0; i < count; i++) {
    const lines = []
    let sec = 0
    for (const m of fixtures[i]) {
      for (const out of m.out) {
        lines.push(JSON.stringify({
          type: 'assistant',
          parentUuid: null,
          isSidechain: true,
          agentId: `stub${i + 1}`,
          sessionId,
          timestamp: `2026-10-13T10:00:${String(sec++).padStart(2, '0')}.000Z`,
          message: {
            model: 'claude-opus-5-5',
            id: m.id,
            type: 'message',
            role: 'assistant',
            content: [{ type: 'text', text: '(scrubbed)' }],
            usage: { input_tokens: m.input, cache_creation_input_tokens: m.cw, cache_read_input_tokens: m.cr, output_tokens: out },
          },
        }))
      }
    }
    fs.writeFileSync(path.join(dir, `agent-${i + 1}.jsonl`), `${lines.join('\n')}\n`)
    fs.writeFileSync(path.join(dir, `agent-${i + 1}.meta.json`), JSON.stringify({
      agentType: 'general-purpose',
      description: 'review the diff',
      toolUseId: `toolu_stub_agent_${i + 1}`,
      spawnDepth: 1,
      requestShape: 'foreground',
      requestNonInteractive: true,
      model: 'claude-opus-5-5',
    }))
  }
  if (step.subagents_unreadable) fs.chmodSync(dir, 0o000)
}

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
}

// `step.wait_sh`: a barrier in place of a guessed delay. The script runs as
// `sh -c` in cwd every 50 ms until it exits 0, for 30 s at most.
function waitFor(cmd) {
  const deadline = Date.now() + 30000
  while (require('node:child_process').spawnSync('sh', ['-c', cmd], { cwd }).status !== 0) {
    if (Date.now() > deadline) {
      process.stderr.write(`wait_sh timed out: ${cmd}\n`)
      return
    }
    sleep(50)
  }
}

function assistant(content) {
  return {
    ...tpl.assistant,
    message: { ...tpl.assistant.message, model: init.model, id: `msg_stub_${n}_${++seq}`, content },
    session_id: sessionId,
    uuid: crypto.randomUUID(),
    timestamp: new Date().toISOString(),
    request_id: `req_stub_${n}_${seq}`,
  }
}

function user(toolUseId, text, isError = false) {
  return {
    ...tpl.user,
    message: { role: 'user', content: [{ tool_use_id: toolUseId, type: 'tool_result', content: text, is_error: isError }] },
    session_id: sessionId,
    uuid: crypto.randomUUID(),
    timestamp: new Date().toISOString(),
  }
}

// Claude Code keeps every session's transcript at projects/<cwd slug>/<session>.jsonl; `report --recount` reads it.
function emit(event) {
  process.stdout.write(`${JSON.stringify(event)}\n`)
  const configDir = process.env.CLAUDE_CONFIG_DIR
  if (!configDir) return
  const dir = path.join(configDir, 'projects', cwd.replace(/[^A-Za-z0-9]/g, '-'))
  fs.mkdirSync(dir, { recursive: true })
  fs.appendFileSync(path.join(dir, `${sessionId}.jsonl`), `${JSON.stringify(event)}\n`)
}

function fail(code, msg) {
  console.error(`stub claude: ${msg}`)
  process.exit(code)
}

function plugin(args) {
  const file = path.join(stubDir, 'plugins.json')
  const state = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : { marketplaces: [], plugins: [] }
  const words = args.filter((a) => !a.startsWith('--'))
  const verb = words.slice(0, words[0] === 'marketplace' ? 2 : 1).join(' ')
  if (verb === 'marketplace list' && args.includes('--json')) {
    process.stdout.write(JSON.stringify(state.marketplaces) + '\n')
  } else if (verb === 'list' && args.includes('--json')) {
    process.stdout.write(JSON.stringify(state.plugins) + '\n')
  } else if (verb === 'marketplace add' && words[2]) {
    const manifest = path.join(words[2], '.claude-plugin', 'marketplace.json')
    if (!fs.existsSync(manifest)) fail(1, `${manifest} does not exist`)
    const name = JSON.parse(fs.readFileSync(manifest, 'utf8')).name
    state.marketplaces = [...state.marketplaces, { name, source: 'directory', path: words[2] }]
    writeAtomic(file, JSON.stringify(state, null, 2))
  } else if (verb === 'install' && words[1]) {
    const scope = args.includes('--scope') ? args[args.indexOf('--scope') + 1] : 'user'
    state.plugins = [...state.plugins, { id: words[1], version: '0.0.0', scope, enabled: true }]
    writeAtomic(file, JSON.stringify(state, null, 2))
  } else {
    fail(64, `claude plugin ${args.join(' ')}: not a call the stub answers`)
  }
  process.exit(0)
}
