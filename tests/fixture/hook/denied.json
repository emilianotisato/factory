  "allowed_on_purpose": [
    {
      "cmd": "python3 - <<'PY'\nfrom pathlib import Path\np = Path('notes.md')\nbody = \"# title\\nUse `cargo test` and avoid `git push` in docs\\n\"\nfor line in body.splitlines():\n    out.push(line)\nPY",
      "why": "markdown backticks are not Ruby backtick exec; out.push is not git push"
    },
    {
      "cmd": "node -e \"const a = []; a.push(1); console.log(`${a}`)\"",
      "why": "JS template literals are not Ruby/Perl backtick exec"
    },
    {
      "cmd": "python3 - <<'PY'\nentry = '''\\n## note\\nbacktick `push` in prose\\n'''\nopen('entry.md','w').write(entry)\nPY",
      "why": "heredoc writes prose with backticks and push, not a subprocess"
    },
    {
      "cmd": "php -r '$c->push(1);'",
      "why": "PHP method push is not git push"
    },
    {
      "cmd": "node -e \"const a = []; a.push(1); console.log(a)\"",
      "why": "array push without template-literal backticks"
    },
